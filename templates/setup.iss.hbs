; Generated by easy-inno {{toolVersion}}. Do not edit; changes are overwritten on every build.

[Setup]
AppId={{appId}}
AppName={{appName}}
AppVersion={{appVersion}}
AppPublisher={{publisher}}
DefaultDirName={{defaultDirName}}
DefaultGroupName={{appName}}
DisableProgramGroupPage=yes
DisableDirPage={{disableDirPage}}
OutputDir={{outputDir}}
OutputBaseFilename={{outputBaseFilename}}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired={{privileges}}
Compression={{compression}}
SolidCompression={{solidCompression}}
UninstallDisplayIcon={{uninstallIcon}}
{{#if iconFile}}
SetupIconFile={{iconFile}}
{{/if}}
WizardStyle=modern
CloseApplications=yes
RestartApplications=no
{{#each extraDirectives}}
{{key}}={{value}}
{{/each}}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: {{stagingSource}}; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"{{desktopTaskFlags}}

[Icons]
{{#if startMenuShortcut}}
Name: {{groupIconName}}; Filename: {{exeFile}}; WorkingDir: {{workingDir}}
{{/if}}
Name: {{desktopIconName}}; Filename: {{exeFile}}; WorkingDir: {{workingDir}}; Tasks: desktopicon

{{#if launchAfterInstall}}
[Run]
Filename: {{exeFile}}; Description: {{runDescription}}; WorkingDir: {{workingDir}}; Flags: nowait postinstall skipifsilent
{{/if}}
